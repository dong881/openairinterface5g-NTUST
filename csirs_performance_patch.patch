-
-      nr_generate_csi_rs(&gNB->frame_parms,
+
+      if (csirs_buf) {
+        // Generate in separate buffer
+        nr_generate_csi_rs_separate(&gNB->frame_parms,
+                                   &mapping_parms,
+                                   gNB->TX_AMP,
+                                   slot,
+                                   csi_params,
+                                   csirs_buf->data);
+      } else {
+        // Fallback to original method
+        nr_generate_csi_rs(&gNB->frame_parms,
