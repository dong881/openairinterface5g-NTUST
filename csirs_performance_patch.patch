   csirs_gen_ns = timespec_diff_ns(&t_func_start, &t_end);
+
+  // Merge CSI-RS buffer with PDSCH if separate buffer was used
+  if (csirs_buf && csirs_buf->active) {
+    struct timespec t_merge_start;
+    clock_gettime(CLOCK_MONOTONIC, &t_merge_start);
+
+    merge_csirs_with_pdsch(gNB->common_vars.txdataF,
+                          csirs_buf,
+                          txdataF_offset,
+                          fp);
+
+    clock_gettime(CLOCK_MONOTONIC, &t_end);
+    long merge_time = timespec_diff_ns(&t_merge_start, &t_end);
